# Insight Studio - Environment Configuration
# Copy this file to .env or /etc/insight-studio.env and customize for your deployment.

# Flask Security (Generate with: python3 -c 'import secrets; print(secrets.token_hex(32))')
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string-in-production
SESSION_COOKIE_SECURE=1

# Storage Paths
WORKSPACE_DIR=/var/lib/insight-studio/workspaces
WORKSPACE_TTL_HOURS=48
MAX_UPLOAD_MB=100

# Server Host & Port
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0

# AI Backend Configuration
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
